# Copie este arquivo para .env.local e substitua SUA_SENHA.
# O run.cmd le este arquivo sem executa-lo e nao sobrescreve variaveis ja definidas no terminal.
ConnectionStrings__EstudosDb=Host=localhost;Port=5432;Database=estudos;Username=postgres;Password=SUA_SENHA

# Opcional: alvo do proxy do Vite. Se omitido, usa http://localhost:5147.
VITE_API_PROXY_TARGET=http://localhost:5147

# Opcional: apenas se o navegador acessar a API diretamente, sem proxy do Vite.
# Cors__AllowedOrigins__0=http://localhost:5173
